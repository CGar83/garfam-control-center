NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Trusted server scripts and Google Calendar sync only. Never browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional server connection. Otherwise each parent supplies a key in Finance > Assistant.
# Never prefix these with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
OPENROUTER_ALLOWED_FAMILY_IDS=

# Required for saving personal OpenRouter keys, server-only, 64 hex characters.
# Generate once: openssl rand -hex 32
# Keep this stable and backed up securely; rotating it requires users to re-save keys.
FINANCE_CREDENTIALS_ENCRYPTION_KEY=

# Google Calendar OAuth: server-only, Functions scope in Netlify.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://family-control-center.netlify.app/api/calendar/google/callback
# Independent 64-hex-character key; keep stable or reconnect Google after rotation.
GOOGLE_CALENDAR_ENCRYPTION_KEY=
